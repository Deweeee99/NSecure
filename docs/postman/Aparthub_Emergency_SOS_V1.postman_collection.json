            "url": {
              "raw": "{{base_url}}/api/resident/emergency/history?per_page=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "resident",
                "emergency",
                "history"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            }
