{
  "info": {
    "name": "Aparthub Emergency SOS V1",
    "_postman_id": "f7d19421-4baf-4a6a-9e0a-aph37sos0001",
    "description": "APH.37 Resident → Security software-only Emergency SOS contract. No panic hardware/push dependency.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost"
    },
    {
      "key": "resident_token",
      "value": ""
    },
    {
      "key": "security_token",
      "value": ""
    },
    {
      "key": "emergency_alert_id",
      "value": ""
    }
  ],
  "item": [
