          "name": "Trigger SOS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{resident_token}}"
              },
              {
                "key": "Accept-Language",
                "value": "id"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Butuh bantuan segera.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/resident/emergency/sos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "resident",
                "emergency",
                "sos"
              ]
            }
          }
        },
        {
          "name": "Current SOS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{resident_token}}"
              },
              {
                "key": "Accept-Language",
                "value": "id"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/resident/emergency/current",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "resident",
                "emergency",
                "current"
              ]
            }
          }
        },
        {
          "name": "SOS History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{resident_token}}"
              },
